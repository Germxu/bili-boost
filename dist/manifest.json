{
  "manifest_version": 3,
  "name": "Bili Boost",
  "version": "0.1.0",
  "description": "B站功能优化：评论区 IP属地、导航自定义、滚轮倍速、视频帧读取、沉浸式进度条",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Bili Boost"
  },
  "content_scripts": [
    {
      "js": [
        "src/content/index.iife.js"
      ],
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
